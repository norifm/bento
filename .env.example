# Copy to .env. No navidrome credentials needed: octo-fiesta gets its own service account.
ND_BASEURL=https://music.example.com
ND_LASTFM_APIKEY=
ND_LASTFM_SECRET=

# Deezer, Qobuz, Tidal, Yandex or SquidWTF
MUSIC_SERVICE=Qobuz
QOBUZ_USER_AUTH_TOKEN=
QOBUZ_USER_ID=
QOBUZ_APP_ID=
QOBUZ_APP_SECRET=
QOBUZ_QUALITY=MP3_320

#DEEZER_ARL=
#DEEZER_QUALITY=MP3_320

EXTERNAL_COVER_INDICATOR_COLOR=#ff0000
DOWNLOAD_MODE=Track
STORAGE_MODE=Permanent

# Cloudflare Tunnel, for hosts without port forwarding (leave empty to disable)
TUNNEL_TOKEN=
